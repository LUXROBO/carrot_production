        "PreBuildEvent" = "8:"
        "PostBuildEvent" = "8:setlocal enabledelayedexpansion\r\n\r\nrem Project Setup 파일\r\nset \"ProjSetupFile=$(ProjectDir)CarrotQA_BG770_Setup.vdproj\"\r\n\r\nrem 버전 가져오기\r\nif exist \"%ProjSetupFile%\" (\r\n    for /f \"tokens=2 delims=:\" %%a in (\r\n        'findstr /c:\"ProductVersion\" \"%ProjSetupFile%\"'\r\n    ) do (\r\n        set ProductVer=%%a   \r\n        set ProductVer=!ProductVer:\"=! \r\n        goto Done\r\n    )\r\n)\r\n\r\n:Done\r\necho 추출된 버전: !ProductVer!\r\n\r\nrem 버전에 공백 제거\r\nset \"ProductVer=!ProductVer: =!\"\r\n\r\nrem 기존 MSI 파일 경로\r\nset \"OrigMSI=$(BuiltOuputPath)\"\r\n\r\nrem 변경할 MSI 파일 이름\r\nset \"NewMSI=$(ProjectDir)$(Configuration)\\CarrotQA_BG770_Setup_!ProductVer!.msi\"\r\n\r\nrem 이름 변경 수행\r\nif exist \"!OrigMSI!\" (\r\n    echo [INFO] 파일 이름 변경 중...\r\n    copy \"!OrigMSI!\" \"CarrotQA_BG770_Setup_v!ProductVer!.msi\"\r\n    echo [OK] 복사 완료: !NewMSI!\r\n) else (\r\n    echo [ERROR] 파일을 찾을 수 없습니다: !OrigMSI!\r\n)"
        "RunPostBuildEvent" = "3:0"
        }
